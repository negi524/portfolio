---
import { Icon } from 'astro-icon/components';
import { EXPERIENCE_DATA, SKILLS_DATA } from '../static/constants';
import BaseLayout from '../layouts/BaseLayout.astro';

const coreSkills = SKILLS_DATA.slice(0, 2);
---

<BaseLayout>
  <div class="space-y-24">
    <!-- Hero Section -->
    <section class="max-w-3xl space-y-8">
      <div class="space-y-4">
        <h1
          class="text-4xl font-semibold tracking-tight text-gray-900 md:text-5xl lg:text-6xl"
        >
          negi524
        </h1>
        <p class="text-xl text-gray-600 md:text-2xl">
          Webサービスで必要なことを全部やります(デザイン以外)
        </p>
      </div>

      <div class="flex gap-4">
        <a
          href="https://github.com/negi524"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 transition-colors hover:text-gray-900"
          aria-label="GitHub"
        >
          <Icon name="mdi:github" class="h-6 w-6" />
        </a>
        <a
          href="https://www.facebook.com/"
          target="_blank"
          class="text-gray-500 transition-colors hover:text-gray-900"
          aria-label="Email"
        >
          <Icon name="mdi:facebook" class="h-6 w-6" />
        </a>
      </div>
    </section>

    <!-- About Section (Short) -->
    <section class="max-w-2xl">
      <h2
        class="mb-6 text-xl font-semibold tracking-wide text-gray-900 uppercase"
      >
        About
      </h2>
      <div class="space-y-4 text-lg leading-relaxed text-gray-700">
        <p>■大切にしていること</p>
        <ul class="list-disc ps-10">
          <li>課題以上の価値は生まれない</li>
          <li>技術は目的ではなく手段である</li>
          <li>目的を達成するために最適な手段を選ぶ</li>
          <li>困難は分割せよ</li>
        </ul>
        <p>■得意なこと</p>
        <ul class="list-disc ps-10">
          <li>フロントエンド〜バックエンド〜データベース一気通貫した開発</li>
          <li>アーキテクチャ全体の設計</li>
          <li>DDDなどのコード設計</li>
          <li>サービスのグロースを視野に入れた0→1開発</li>
        </ul>
      </div>
    </section>

    <!-- Skills Highlight -->
    <section class="border-t border-gray-200 pt-12">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-xl font-semibold tracking-wide text-gray-900 uppercase">
          Core Competencies
        </h2>
        <a
          href="/skills"
          class="hidden text-sm text-gray-500 transition-colors hover:text-gray-900 md:block"
        >
          View all skills
        </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          coreSkills.map((category) => (
            <div class="border border-gray-200 bg-white p-8 shadow-sm">
              <h3 class="text-md mb-4 font-medium text-gray-900">
                {category.title}
              </h3>
              <ul class="space-y-2">
                {category.skills.slice(0, 3).map((skill) => (
                  <li class="flex items-center text-base text-gray-700">
                    <span class="mr-3 inline-block h-1.5 w-1.5 bg-gray-400" />
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-6 md:hidden">
        <a
          href="/skills"
          class="text-sm text-gray-500 transition-colors hover:text-gray-900"
        >
          View all skills &rarr;
        </a>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="border-t border-gray-200 pt-12">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-xl font-semibold tracking-wide text-gray-900 uppercase">
          Experience
        </h2>
        <a
          href="/skills"
          class="hidden text-sm text-gray-500 transition-colors hover:text-gray-900 md:block"
        >
          View skills
        </a>
      </div>

      <div class="space-y-6">
        {
          EXPERIENCE_DATA.map((exp) => (
            <div>
              <div class="mb-2 text-sm font-medium text-gray-500">
                {exp.period}
              </div>
              <div class="border border-gray-200 bg-white p-6">
                <h3 class="mb-3 text-lg font-semibold text-gray-900">
                  {exp.title}
                </h3>
                <ul class="space-y-2">
                  {exp.description.map((item) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <span class="mt-1.5 mr-2 h-1 w-1 flex-shrink-0 rounded-full bg-gray-400" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
