---
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS_DATA, SKILLS_DATA } from '../static/constants';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredProjects = PROJECTS_DATA.slice(0, 2);
const coreSkills = SKILLS_DATA.slice(0, 2);
---

<BaseLayout>
  <div class="space-y-24">
    <!-- Hero Section -->
    <section class="max-w-3xl space-y-8">
      <div class="space-y-4">
        <h1
          class="text-4xl font-semibold tracking-tight text-gray-900 md:text-5xl lg:text-6xl"
        >
          山田 太郎
        </h1>
        <p class="text-xl text-gray-600 md:text-2xl">
          東京を拠点とするフルスタックエンジニア
        </p>
      </div>

      <div class="flex gap-4">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 transition-colors hover:text-gray-900"
          aria-label="GitHub"
        >
          <Icon name="mdi:github" class="h-6 w-6" />
        </a>
        <a
          href="https://twitter.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 transition-colors hover:text-gray-900"
          aria-label="Twitter"
        >
          <Icon name="mdi:twitter" class="h-6 w-6" />
        </a>
        <a
          href="mailto:hello@example.com"
          class="text-gray-500 transition-colors hover:text-gray-900"
          aria-label="Email"
        >
          <Icon name="mdi:email" class="h-6 w-6" />
        </a>
      </div>
    </section>

    <!-- About Section (Short) -->
    <section class="max-w-2xl">
      <h2
        class="mb-6 text-xl font-semibold tracking-wide text-gray-900 uppercase"
      >
        About
      </h2>
      <div class="space-y-4 text-lg leading-relaxed text-gray-700">
        <p>
          シンプルさとパフォーマンスに重点を置いた、信頼性の高いWebアプリケーションを構築しています。
          数学のバックグラウンドを持ち、クリーンで保守性の高いコードで複雑な問題を解決することを楽しんでいます。
        </p>
        <p>
          現在は、開発者の生産性を向上させるためにRustとエージェント型AIワークフローを探求しています。
        </p>
      </div>
    </section>

    <!-- Skills Highlight -->
    <section class="border-t border-gray-200 pt-12">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-xl font-semibold tracking-wide text-gray-900 uppercase">
          Core Competencies
        </h2>
        <a
          href="/skills"
          class="hidden text-sm text-gray-500 transition-colors hover:text-gray-900 md:block"
        >
          View all skills
        </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          coreSkills.map((category) => (
            <div class="border border-gray-200 bg-white p-8 shadow-sm">
              <h3 class="text-md mb-4 font-medium text-gray-900">
                {category.title}
              </h3>
              <ul class="space-y-2">
                {category.skills.slice(0, 3).map((skill) => (
                  <li class="flex items-center text-base text-gray-700">
                    <span class="mr-3 inline-block h-1.5 w-1.5 bg-gray-400" />
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-6 md:hidden">
        <a
          href="/skills"
          class="text-sm text-gray-500 transition-colors hover:text-gray-900"
        >
          View all skills &rarr;
        </a>
      </div>
    </section>

    <!-- Selected Projects -->
    <section class="border-t border-gray-200 pt-12">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-xl font-semibold tracking-wide text-gray-900 uppercase">
          Selected Work
        </h2>
        <a
          href="/projects"
          class="hidden text-sm text-gray-500 transition-colors hover:text-gray-900 md:block"
        >
          View archive
        </a>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>
