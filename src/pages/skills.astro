---
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SKILLS_DATA } from '../static/constants';

const capabilities: string[] = [
  'WebAPIの設計、開発',
  'バッチの設計、開発',
  'Webサービスの開発',
  'データベースの設計',
  'エンジニアチームのマネジメント',
  '検索システムの設計、開発',
  'LLMを活用したワークフローの構築',
];
---

<BaseLayout>
  <div>
    <SectionHeader
      title="Technical Skills"
      subtitle="A categorized overview of my technical proficiency and toolset."
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        SKILLS_DATA.map((category) => (
          <div class="border border-gray-200 bg-white p-8 shadow-sm">
            <h3 class="mb-6 border-b border-gray-100 pb-3 text-lg font-semibold text-gray-900">
              {category.title}
            </h3>
            <ul class="grid grid-cols-1 gap-3">
              {category.skills.map((skill) => (
                <li class="flex items-start text-gray-700">
                  <span class="mt-2 mr-3 inline-block h-1.5 w-1.5 rounded-none bg-gray-400" />
                  <span class="text-base">{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-16 border border-gray-200 bg-gray-100 p-8 text-center">
      <h4 class="text-md mb-2 font-medium text-gray-900">Always Learning</h4>
      <p class="mx-auto max-w-2xl text-sm text-gray-600">
        Technology moves fast. While this list represents my current core
        competencies, I pride myself on my ability to adapt and learn new tools
        as the problem requires.
      </p>
    </div>
  </div>
</BaseLayout>
