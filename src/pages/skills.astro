---
import Layout from '../layouts/Layout.astro';

interface SkillCategory {
  icon: string;
  title: string;
  color: string;
  skills: string[];
}

const capabilities: string[] = [
  'WebAPIの設計、開発',
  'バッチの設計、開発',
  'Webサービスの開発',
  'データベースの設計',
  'エンジニアチームのマネジメント',
  '検索システムの設計、開発',
  'LLMを活用したワークフローの構築',
];

const categories: SkillCategory[] = [
  {
    icon: '💻',
    title: 'フロントエンド',
    color: '#3b82f6',
    skills: [
      'HTML',
      'CSS, SCSS',
      'TypeScript, JavaScript',
      'React, ReactRouter',
      'Vue, Nuxt.js',
      'Astro',
    ],
  },
  {
    icon: '⚙️',
    title: 'バックエンド',
    color: '#10b981',
    skills: [
      'Java, SpringBoot',
      'TypeScript, NestJS',
      'Python, FastAPI',
      'Ruby on Rails',
      'Solr',
    ],
  },
  {
    icon: '🎨',
    title: '設計・アーキテクチャ',
    color: '#8b5cf6',
    skills: ['ドメイン駆動設計', 'クリーンアーキテクチャ', 'API設計'],
  },
  {
    icon: '🤖',
    title: 'LLM・AI',
    color: '#f59e0b',
    skills: ['Claude Code', 'MCP', 'Dify'],
  },
  {
    icon: '🚀',
    title: 'インフラ・DevOps',
    color: '#ef4444',
    skills: ['GitHub Actions', 'Docker', 'Kubernetes'],
  },
  {
    icon: '🛠️',
    title: 'ツール',
    color: '#6b7280',
    skills: [
      'n8n',
      'NeoVim',
      'VSCode',
      'IntelliJ',
      'Slack',
      'Zoom',
      'Figma',
      'Miro',
      'Notion',
      'Jira, Confluence',
    ],
  },
];
---

<Layout>
  <main class="min-h-screen bg-gradient-to-br from-gray-100 to-blue-100 py-8 px-4 font-sans">
    <div class="container mx-auto max-w-7xl">
      <h1 class="mb-12 text-center text-5xl font-bold tracking-tight text-gray-900 md:text-6xl">
        Skills
      </h1>

      <section class="mb-12 rounded-2xl bg-white p-6 shadow-md md:p-8">
        <h2 class="mb-4 text-2xl font-semibold text-gray-900">できること</h2>
        <ul class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
          {
            capabilities.map((capability) => (
              <li class="flex items-center py-2 text-sm text-gray-700 md:text-base">
                <span class="mr-3 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-sm font-semibold text-white">
                  ✓
                </span>
                {capability}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {
          categories.map((category) => (
            <article
              class="transform rounded-xl border-t-4 bg-white p-5 shadow transition-all duration-300 hover:-translate-y-1 hover:shadow-xl md:p-6"
              style={`border-top-color: ${category.color}`}
            >
              <div class="mb-4 flex items-center gap-3">
                <span class="text-3xl leading-none" aria-hidden="true">
                  {category.icon}
                </span>
                <h3 class="text-xl font-semibold text-gray-900">
                  {category.title}
                </h3>
              </div>
              <ul class="space-y-0">
                {category.skills.map((skill, index) => (
                  <li
                    class={`border-gray-100 py-2 text-sm text-gray-600 ${
                      index < category.skills.length - 1 ? 'border-b' : ''
                    }`}
                  >
                    {skill}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
