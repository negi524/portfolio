---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'clifford' } },
    { params: { slug: 'rover' } },
    { params: { slug: 'spot' } },
  ];
}

const { slug } = Astro.params;
---

<BaseLayout>
  <div>Good slug, {slug}!</div>
</BaseLayout>
