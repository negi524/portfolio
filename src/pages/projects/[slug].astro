---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS_DATA } from '../../static/constants';
import type { Project } from '../../types';

export function getStaticPaths() {
  return PROJECTS_DATA.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = PROJECTS_DATA.find((p) => p.slug === slug) as Project;
---

<BaseLayout>
  <article class="animate-fade-in">
    <!-- Back Link -->
    <a
      href="/projects"
      class="mb-8 inline-flex items-center text-sm text-gray-500 transition-colors hover:text-gray-900"
    >
      <svg
        class="mr-2 h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 12H5m7-7l-7 7 7 7"></path>
      </svg>
      Back to Projects
    </a>

    <!-- Header -->
    <header class="mb-12">
      <div class="mb-4 flex flex-wrap gap-2">
        {
          project.tags.map((tag) => (
            <span class="border border-gray-200 bg-white px-2 py-1 text-xs font-semibold uppercase tracking-wider text-gray-500">
              {tag}
            </span>
          ))
        }
      </div>
      <h1
        class="mb-6 text-3xl font-bold tracking-tight text-gray-900 md:text-5xl"
      >
        {project.title}
      </h1>
      <p class="max-w-3xl text-xl leading-relaxed text-gray-600">
        {project.summary}
      </p>
    </header>

    <!-- Hero Image -->
    <div
      class="mb-12 h-64 w-full overflow-hidden border border-gray-200 bg-gray-200 md:h-96"
    >
      <img
        src={project.thumbnailUrl}
        alt={project.title}
        class="h-full w-full object-cover grayscale transition-all duration-700 hover:grayscale-0"
      />
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <!-- Main Content -->
      <div class="space-y-12 lg:col-span-2">
        <section>
          <h2 class="mb-4 text-xl font-semibold text-gray-900">Overview</h2>
          <p class="whitespace-pre-line leading-relaxed text-gray-700">
            {project.description}
          </p>
        </section>

        {
          project.challenges && (
            <section>
              <h2 class="mb-4 text-xl font-semibold text-gray-900">
                The Challenge
              </h2>
              <p class="leading-relaxed text-gray-700">{project.challenges}</p>
            </section>
          )
        }

        {
          project.solutions && (
            <section>
              <h2 class="mb-4 text-xl font-semibold text-gray-900">
                The Solution
              </h2>
              <p class="leading-relaxed text-gray-700">{project.solutions}</p>
            </section>
          )
        }
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <div class="border border-gray-200 bg-white p-6">
          <h3
            class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-400"
          >
            Project Details
          </h3>
          <ul class="space-y-4 text-sm">
            <li class="flex justify-between border-b border-gray-100 pb-2">
              <span class="text-gray-500">Year</span>
              <span class="font-medium text-gray-900">{project.year}</span>
            </li>
          </ul>
        </div>

        <div class="border border-gray-200 bg-white p-6">
          <h3
            class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-400"
          >
            Tech Stack
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              project.techStack.map((tech) => (
                <span class="rounded-none bg-gray-100 px-2 py-1 text-xs text-gray-700">
                  {tech}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
