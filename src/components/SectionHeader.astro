---
interface SectionHeaderProps {
  title: string;
  subtitle?: string;
  className?: string;
}

const { title, subtitle, className = '' } = Astro.props;
---

<div class={`mb-12 ${className}`}>
  <h2
    class="mb-3 text-2xl font-semibold tracking-tight text-gray-900 md:text-3xl"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="max-w-2xl text-lg leading-relaxed text-gray-600">{subtitle}</p>
    )
  }
</div>
