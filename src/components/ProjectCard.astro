---
import type { Project } from '../types.ts';

export interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="group block flex h-full flex-col border border-gray-200 bg-white p-6 transition-colors duration-200 hover:border-gray-400"
>
  <div class="mb-4 flex items-start justify-between">
    <div class="flex flex-wrap gap-2">
      {
        project.tags.slice(0, 2).map((tag) => (
          <span
            key={tag}
            class="bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500"
          >
            {tag}
          </span>
        ))
      }
    </div>
    <ArrowUpRight
      class="h-5 w-5 text-gray-400 transition-colors group-hover:text-gray-900"
    />
  </div>

  <h3
    class="mb-2 text-xl font-semibold text-gray-900 decoration-1 underline-offset-4 group-hover:underline"
  >
    {project.title}
  </h3>

  <p class="mb-6 flex-grow text-sm leading-relaxed text-gray-600">
    {project.summary}
  </p>

  <div
    class="mt-auto flex items-center justify-between border-t border-gray-100 pt-4 text-xs text-gray-400"
  >
    <span>{project.year}</span>
    <span>{project.role}</span>
  </div>
</a>
